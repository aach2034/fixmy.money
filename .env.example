NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_STEP_UP_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# ISO timestamp for the production cutoff. Users created before this instant retain billing access.
SIGNUP_SHUTDOWN_STARTED_AT=2026-09-05T00:00:00-04:00
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 32+ random characters; authorizes only the durable webhook/outbox worker.
STRIPE_WEBHOOK_WORKER_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
OPENAI_API_KEY=
# Explicit server-side kill switch. Keep false until an authorized production rollout.
AI_GATEWAY_ENABLED=false
# Public Turnstile widget key. The matching secret remains server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_SIGNUP_ENABLED=false
LEAD_RATE_LIMIT_SALT=
HEALTHCHECK_SECRET=
