{
  "name": "fix-my-money",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@dhiwise/component-tagger",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": "🚨 CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "dev": "vinext dev --port 4028",
    "build": "vinext build",
    "build:next": "next build",
    "start": "vinext start --port 4028",
    "lint": "eslint src scripts tests",
    "lint:fix": "eslint src scripts tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "seo:audit": "tsx scripts/seo-health-report.ts",
    "verify-env": "tsx scripts/verify-env.ts",
    "seed-admin": "tsx scripts/seed-platform-admin.ts",
    "seed-test": "tsx scripts/seed-test-fixtures.ts",
    "teardown-test": "tsx scripts/seed-test-fixtures.ts --teardown",
    "migrate:export": "tsx scripts/export-source-schema.ts",
    "migrate:auth": "tsx scripts/migrate-auth-users.ts",
    "migrate:data": "tsx scripts/migrate-to-fixmymoney-project.ts",
    "migrate:data:dry": "tsx scripts/migrate-to-fixmymoney-project.ts --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@rocketnew/llm-sdk": "1.1.0",
    "@stripe/react-stripe-js": "6.6.0",
    "@stripe/stripe-js": "9.7.0",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.107.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "lucide-react": "^1.19.0",
    "next": "15.5.21",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.77.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.15.2",
    "sharp": "0.35.0",
    "sonner": "^1.7.4",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^20",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "8.5.12",
    "prettier": "^3.5.3",
    "react-server-dom-webpack": "19.0.3",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.22.4",
    "typescript": "^5",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "vitest": "^2.0.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
